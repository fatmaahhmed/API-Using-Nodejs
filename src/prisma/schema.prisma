generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}
model copon {
  copon_id      Int       @id @default(autoincrement())
  copon_code    String    @unique
  discount      Float
  start_date    DateTime
  end_date      DateTime 
  number_of_available_copons Int  @default(0)
  is_active     Boolean   @default(true)
  type          String    @default("percentage")
  user_id       Int      
  user          user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  cart          cart[]
  @@index([user_id])
  @@index([copon_code])
}

model cart {
  cart_id    Int        @id @default(autoincrement())
  user_id    Int        @unique
  copon_id    Int?
  copon       copon?   @relation(fields: [copon_id], references: [copon_id], onDelete: SetNull, onUpdate: Cascade)
  cartItem_id Int        @default(0)
  total_price      Float      @default(0)  // Added to store cart total
  total_with_copon Float @default(0)
  status     String     @default("active") 
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @default(now())
  user       user       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  cartItems  cartItem[]

  @@index([user_id])
}

model cartItem {
  cartItem_id Int      @id @default(autoincrement())
  cart_id     Int
  product_id  Int
  quantity    Int      @default(1)
  unit_price  Int 
  subtotal    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
  cart        cart     @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: Cascade)
  product     product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([cart_id, product_id]) // Prevent duplicate products in cart
  @@index([cart_id])    
  @@index([product_id])

}

model user {
  user_id                   Int        @id @default(autoincrement())
  username                  String     @unique
  name                      String
  email                     String     @unique
  password                  String
  token                     String     @default("")
  role                      String     @default("User")
  verificationCode          String     @default("")
  verification_code_expires DateTime   @default(now())
  verified                  Boolean    @default(false)
  createdAt                 DateTime   @default(now()) // Added for user tracking
  updatedAt                 DateTime   @default(now())      // Added for user tracking
  brands                    brand[]
  categories                category[]
  orders                    order[]
  products                  product[]
  reviews                   review[]
  wishList                  wishList[]
  copons                    copon[]
  cart                     cart?

  @@index([email])
  @@index([username])
}

model category {
  category_id     Int        @id @unique @default(autoincrement())
  category_name   String     @unique
  slug            String    @default("")
  user_id         Int
  parent_id       Int?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now())
  parentCategory  category?  @relation("ParentRelation", fields: [parent_id], references: [category_id], onDelete: SetNull, onUpdate: Cascade)
  childCategories category[] @relation("ParentRelation")
  Admin           user       @relation(fields: [user_id], references: [user_id], onDelete: Cascade,onUpdate: Cascade)
  products        product[]

  @@index([slug])
  @@index([parent_id])
  @@index([user_id])
}

model product {
  product_id      Int        @id @default(autoincrement())
  product_name    String     @unique
  slug            String    @default("")
  quantity        Int        @default(0)
  in_stock        Boolean    @default(true)
  description     String
  price           Float
  color           String     @default("")
  brand_name        String   @default("")
  rating          Float      @default(0)
  reviews_count   Int        @default(0)
  is_best_seller  Boolean    @default(false)
  is_on_sale      Boolean    @default(false)
  sale_start_date DateTime?
  sale_end_date   DateTime?
  discount_price  Float?
  category_id     Int?
  user_id         Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now())
  // orders          order[]
  brand           brand      @relation(fields: [brand_name], references: [brand_name], onDelete: Cascade, onUpdate: Cascade)
  user            user       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  category        category?  @relation(fields: [category_id], references: [category_id], onDelete: SetNull, onUpdate: Cascade)
  reviews         review[]
  WishList        wishList[]
  cartItems       cartItem[]

  @@index([slug])
  @@index([category_id])
  @@index([user_id])
  @@index([is_best_seller])
  @@index([is_on_sale])
}

model wishList {
  wishlist_id Int      @id @default(autoincrement())
  product_id  Int
  user_id     Int
  createdAt   DateTime @default(now())
  user        user     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  product     product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([wishlist_id, product_id, user_id])
  @@index([product_id])
  @@index([user_id])
}

model review {
  review_id  Int      @id @default(autoincrement())
  product_id Int
  user_id    Int
  rating     Float    @default(0)
  content    String?  // Added for review text
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  user       user     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  product    product  @relation(fields: [product_id], references: [product_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([product_id])
  @@index([user_id])
}

model brand {
  brand_id   Int       @id @default(autoincrement())
  brand_name String    @default("") @unique 
  slug       String    @unique
  user_id    Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) // Changed to have default
  user       user      @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)
  products   product[]

  @@index([slug])
  @@index([user_id])
}
model order {
  order_id        Int      @id @default(autoincrement())
  user_id         Int
  cart_id         Int
  time_to_deliver DateTime
  address         String

  total_price     Float
  order_date      DateTime @default(now())
  status          String   @default("pending") // Added to track order status
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
  // cart            cart     @relation(fields: [cart_id], references: [cart_id], onDelete: Cascade, onUpdate: Cascade)
  user            user     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: Cascade)

  @@index([user_id])

  @@index([order_date])
}